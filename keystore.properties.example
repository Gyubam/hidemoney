# Release Keystore 설정 — 출시 서명용
# 이 파일을 keystore.properties로 복사하고 본인 값 입력 (gitignore 처리됨)
#
# 절대 잃어버리면 안 됨!
# - .jks 파일 + 이 properties 두 곳 모두 외장 SSD / Google Drive 백업
# - 분실 시 Play Store 앱 업데이트 영구 불가 (계정 새로 만들어야)
#
# Play Console에서 "Play 앱 서명" 사용하면 키 분실 시 복구 가능 (권장)

storeFile=../hidemoney-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=hidemoney
keyPassword=YOUR_KEY_PASSWORD
